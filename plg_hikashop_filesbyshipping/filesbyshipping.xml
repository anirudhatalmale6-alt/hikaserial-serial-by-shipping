<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="hikashop" method="upgrade">
	<name>Hide download files by shipping - HikaShop plugin</name>
	<author>Anirudha Talmale</author>
	<creationDate>2026-07</creationDate>
	<version>1.0.0</version>
	<description>PLG_HIKASHOP_FILESBYSHIPPING_DESC</description>

	<files>
		<filename plugin="filesbyshipping">filesbyshipping.php</filename>
		<folder>fields</folder>
		<folder>language</folder>
	</files>

	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.plg_hikashop_filesbyshipping.ini</language>
		<language tag="en-GB">en-GB/en-GB.plg_hikashop_filesbyshipping.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">

				<field name="shipping_ids"
					type="hikashippingmethods"
					addfieldpath="/plugins/hikashop/filesbyshipping/fields"
					multiple="true"
					default=""
					label="PLG_HIKASHOP_FILESBYSHIPPING_SHIPPING_IDS_LABEL"
					description="PLG_HIKASHOP_FILESBYSHIPPING_SHIPPING_IDS_DESC" />

				<field name="no_shipping_behaviour"
					type="list"
					default="block"
					label="PLG_HIKASHOP_FILESBYSHIPPING_NOSHIP_LABEL"
					description="PLG_HIKASHOP_FILESBYSHIPPING_NOSHIP_DESC">
					<option value="block">PLG_HIKASHOP_FILESBYSHIPPING_NOSHIP_BLOCK</option>
					<option value="send">PLG_HIKASHOP_FILESBYSHIPPING_NOSHIP_SEND</option>
				</field>

				<field name="debug_log"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="0"
					label="PLG_HIKASHOP_FILESBYSHIPPING_DEBUG_LABEL"
					description="PLG_HIKASHOP_FILESBYSHIPPING_DEBUG_DESC">
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

			</fieldset>
		</fields>
	</config>
</extension>
